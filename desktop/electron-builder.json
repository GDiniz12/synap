{
  "appId": "app.synap.desktop",
  "productName": "Synap",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "publish": {
    "provider": "github",
    "owner": "GDiniz12",
    "repo": "synap",
    "releaseType": "release"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "resources/**/*"
  ],
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "maintainer": "Synap <contact@synap.app>",
    "icon": "resources/icon.png"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "icon": "resources/icon.png"
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
