# =============================================
# SYNAP BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# =============================================

# Porta do servidor HTTP
PORT=3000

# String de conexão PostgreSQL do Supabase (Transaction Pooler ou Direct Connection)
# Exemplo Supabase: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/synap

# Chave secreta segura para assinatura dos tokens JWT (gere uma chave forte e aleatória)
# Exemplo: openssl rand -base64 32
JWT_SECRET=super-secure-production-jwt-secret-key-change-me

# URL do Frontend (para CORS em produção)
# Exemplo: https://synap.vercel.app,http://localhost:3001
CORS_ORIGIN=*

# URL pública do backend para links de uploads de imagem
# Exemplo: https://synap-backend.onrender.com
PUBLIC_URL=http://localhost:3000
